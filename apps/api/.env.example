DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gtlt?schema=public"
JWT_SECRET="change-me-in-local-dev"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
# Fotos (Azure Blob Storage) — opcional en local; sin esto /uploads/photo responde 503.
# Autenticación vía DefaultAzureCredential (managed identity en Azure, az CLI login local).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=gtlt-photos
