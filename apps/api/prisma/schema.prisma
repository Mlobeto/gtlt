enum WeightMethod {
  SCALE
  TAPE
  VISUAL_ESTIMATE
}

/// Registro de peso, append-only simple (sin VOIDED: un peso mal cargado se explica en notes
/// de uno nuevo, no dispara consecuencias aguas abajo como HealthEvent/MilkingSession).
model WeightEvent {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  tamboId          String       @map("tambo_id") @db.Uuid
  animalId         String       @map("animal_id") @db.Uuid
  weightKg         Decimal      @map("weight_kg") @db.Decimal(6, 2)
  method           WeightMethod @default(VISUAL_ESTIMATE)
  measuredAt       DateTime     @map("measured_at")
  notes            String?
  createdById      String       @map("created_by_id") @db.Uuid
  clientMutationId String?      @map("client_mutation_id")
