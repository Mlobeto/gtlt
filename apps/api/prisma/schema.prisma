  createdBy User   @relation("WeightCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId, animalId, measuredAt])
  @@index([tenantId, tamboId, measuredAt])
  @@index([tenantId, clientMutationId])
  @@map("weight_events")
}

// -----------------------------------------------------------------------------
// Mantenimiento de equipo (PartType catálogo + PartInstance)
// Reemplaza el stub genérico MilkingEquipment.
// -----------------------------------------------------------------------------

/// Catálogo global de tipos de pieza (no es por tenant).
model PartType {
  id                    String                 @id @default(uuid()) @db.Uuid
  code                  String                 @unique
  name                  String
  pattern               PartReplacementPattern
  /// Default 2000 para USAGE_BASED; override por tenant en TenantPartTypeConfig.
  defaultUsageThreshold Int?                   @map("default_usage_threshold")
  /// true = pertenece al grupo de ordeñe por bajada (centralizador, copas, pezoneras, tubos).
  appliesPerBajada      Boolean                @map("applies_per_bajada") @default(false)
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  instances      PartInstance[]
  tenantConfigs  TenantPartTypeConfig[]

  @@map("part_types")
}

model TenantPartTypeConfig {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  partTypeId     String @map("part_type_id") @db.Uuid
  usageThreshold Int    @map("usage_threshold")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  partType PartType @relation(fields: [partTypeId], references: [id])

  @@unique([tenantId, partTypeId])
  @@map("tenant_part_type_configs")
}

/// Pieza real instalada en un tambo (y bajada si aplica).
/// Al reemplazar: setear replacedAt (no borrar) y crear una PartInstance nueva.
///
/// usageCounter (solo USAGE_BASED) — CALCULADO por la app, no carga manual:
///   (vacas_en_ordeño_del_tambo / tambo.bajadaCount)
///     × (nº de MilkingSession ACTIVE del tambo desde installedAt)
/// donde vacas_en_ordeño ≈ count Animal status=ACTIVE en ese tambo.
///
/// Alertas automáticas por umbral: lógica de aplicación sobre estos datos — no implementar aquí.
///
/// REGLAS APP (no expresables como FK/CHECK entre tablas) — ver docs/reglas-negocio-app.md:
/// - si PartType.appliesPerBajada = true  → bajadaNumber OBLIGATORIO
/// - si PartType.appliesPerBajada = false → bajadaNumber debe ser NULL
/// - si bajadaNumber != null → 1 <= bajadaNumber <= Tambo.bajadaCount
///
/// FASE 2 SENSORES: vacuómetro / sensor de bomba / lectura EKC 202 se modelan como
/// Sensor|SensorReading asociados a Tambo y/o a esta PartInstance (frío BRANDED),
/// sin mezclar telemetría dentro de PartInstance.
model PartInstance {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tamboId          String    @map("tambo_id") @db.Uuid
  partTypeId       String    @map("part_type_id") @db.Uuid
  /// Nullable: solo grupo de ordeñe por bajada. Piezas a nivel tambo (ej. frío) → null.
  /// Validación app: ver comentario del model + docs/reglas-negocio-app.md
  bajadaNumber     Int?      @map("bajada_number")
  installedAt      DateTime  @map("installed_at")
  /// Texto libre opcional; la mayoría de piezas genéricas no tienen marca identificable.
  brandModel       String?   @map("brand_model")
  /// URL storage externo (TBD). Puede ser el dato principal de identificación visual.
  photoUrl         String?   @map("photo_url")
  usageCounter     Decimal?  @map("usage_counter") @db.Decimal(14, 2)
  replacedAt       DateTime? @map("replaced_at")
  notes            String?
  createdById      String?   @map("created_by_id") @db.Uuid
  clientMutationId String?   @map("client_mutation_id")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  tambo         Tambo                @relation(fields: [tamboId], references: [id])
  partType      PartType             @relation(fields: [partTypeId], references: [id])
  createdBy     User?                @relation("PartCreatedBy", fields: [createdById], references: [id])
  coldDetail      ColdEquipmentDetail?
  milkDeliveries  MilkDelivery[]
  serviceRequests ServiceRequest[]

  @@index([tenantId, tamboId, replacedAt])
  @@index([tenantId, tamboId, bajadaNumber, partTypeId])
  @@index([tenantId, clientMutationId])
  /// PARTIAL UNIQUE (migración SQL — docs/partial-indexes.sql): DOS índices,
  /// porque en Postgres NULL != NULL y un único índice con bajada_number no
  /// impediría dos equipos de frío vigentes en el mismo tambo.
  ///   1) (tambo_id, part_type_id, bajada_number) WHERE replaced_at IS NULL AND bajada_number IS NOT NULL
  ///   2) (tambo_id, part_type_id)              WHERE replaced_at IS NULL AND bajada_number IS NULL
  @@map("part_instances")
}

/// Ticket de service (no usa patrón VOIDED/corrects*: mal cargado → CANCELLED + uno nuevo).
model ServiceRequest {
  id                      String                 @id @default(uuid()) @db.Uuid
  tenantId                String                 @map("tenant_id") @db.Uuid
  tamboId                 String                 @map("tambo_id") @db.Uuid
  category                ServiceRequestCategory
  relatedPartInstanceId   String?                @map("related_part_instance_id") @db.Uuid
  description             String
  urgency                 ServiceRequestUrgency  @default(NORMAL)
  status                  ServiceRequestStatus   @default(OPEN)
  assignedTechnicianUserId String?               @map("assigned_technician_user_id") @db.Uuid
  createdById             String                 @map("created_by_id") @db.Uuid
  /// Dueño/admin que aprobó (si pasó por PENDING_APPROVAL).
  approvedById            String?                @map("approved_by_id") @db.Uuid
  approvedAt              DateTime?              @map("approved_at")
  resolvedAt              DateTime?              @map("resolved_at")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  tambo               Tambo          @relation(fields: [tamboId], references: [id])
  relatedPartInstance PartInstance?  @relation(fields: [relatedPartInstanceId], references: [id])
  assignedTechnician  User?          @relation("ServiceRequestAssignedTo", fields: [assignedTechnicianUserId], references: [id])
  createdBy           User           @relation("ServiceRequestCreatedBy", fields: [createdById], references: [id])
  approvedBy          User?          @relation("ServiceRequestApprovedBy", fields: [approvedById], references: [id])

  @@index([tenantId, tamboId, status])
  @@index([tenantId, assignedTechnicianUserId, status])
  @@index([relatedPartInstanceId])
  @@map("service_requests")
}

/// Bandeja in-app (push Expo/WhatsApp después). Destinatario = User.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tamboId   String?          @map("tambo_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// JSON: { serviceRequestId, urgency, ... }
  payload   Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tambo  Tambo? @relation(fields: [tamboId], references: [id])

  @@index([tenantId, userId, readAt, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @map("tenant_id") @db.Uuid
  tamboId     String?               @map("tambo_id") @db.Uuid
  userId      String                @map("user_id") @db.Uuid
  category    SupportTicketCategory
  subject     String
  description String
  priority    SupportTicketPriority @default(MEDIUM)
  status      SupportTicketStatus   @default(OPEN)
  internalNote String?               @map("internal_note")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  tambo  Tambo? @relation(fields: [tamboId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, tamboId, status])
  @@map("support_tickets")
}

model AppPrototypeConfig {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  name         String   @default("Prototipo")
  version      String?
  codeUrl      String?  @map("code_url")
  prototypeUrl String?  @map("prototype_url")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, active])
  @@map("app_prototype_configs")
}

/// Campos propios del equipo de frío (PartType.pattern = BRANDED), 1:1 con PartInstance.
model ColdEquipmentDetail {
  partInstanceId   String  @id @map("part_instance_id") @db.Uuid
  brand            String
  model            String
  capacityLiters   Decimal @map("capacity_liters") @db.Decimal(12, 2)
  /// Capacidad de frío — unidad/formato a confirmar en UI; string flexible en Fase 1.
  coolingCapacity  String  @map("cooling_capacity")
  /// ej. EKC 202 (con Modbus/LON) vs EKC 101 (sin salida). Gancho integración Fase 2.
  controllerModel  String? @map("controller_model")

  partInstance PartInstance @relation(fields: [partInstanceId], references: [id], onDelete: Cascade)

  @@map("cold_equipment_details")
}

// -----------------------------------------------------------------------------
// Suscripción / facturación
// -----------------------------------------------------------------------------

/// Catálogo de planes. LIFETIME = sin costo, asignado a mano por la desarrolladora.
model Plan {
  id      String   @id @default(uuid()) @db.Uuid
  code    PlanCode @unique
  name    String
  /// Precio de referencia en USD (ej. 21.00). Null = plan sin componente en USD (ej. lifetime).
  priceUsd Decimal? @map("price_usd") @db.Decimal(10, 2)
  /// Precio en pesos cacheado; se recalcula desde priceUsd + cotización oficial (ver plan-pricing.ts).
  priceArs Int      @map("price_ars")
  /// Cotización (venta, dólar oficial) usada en el último recálculo de priceArs.
  fxRate   Decimal? @map("fx_rate") @db.Decimal(10, 2)
  /// Fuente de la cotización, ej. "OFICIAL".
  fxRateSource      String?   @map("fx_rate_source")
  priceArsUpdatedAt DateTime? @map("price_ars_updated_at")
  /// null = sin recurrencia (lifetime)
  billingIntervalMonths Int?     @map("billing_interval_months")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

/// Una suscripción activa por tenant. El acceso del tenant se deriva de `status`.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @unique @map("tenant_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now()) @map("started_at")
  /// null para planes sin recurrencia (lifetime)
  currentPeriodEnd DateTime?          @map("current_period_end")
  /// id de preapproval de Mercado Pago, cuando exista integración real
  mpSubscriptionId String?            @map("mp_subscription_id")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

/// Historial de pagos, manuales (venta personal) o de Mercado Pago (a futuro).
model Payment {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  subscriptionId String?         @map("subscription_id") @db.Uuid
  provider       PaymentProvider
  /// id de pago de Mercado Pago, cuando aplique
  externalId     String?         @map("external_id")
  amountArs      Int             @map("amount_ars")
  status         PaymentStatus   @default(PENDING)
  paidAt         DateTime?       @map("paid_at")
  /// notas internas, ej. detalle de venta manual
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status])
  @@map("payments")
}
